# Copy this file to `.env` and fill in the values.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app (these are public keys, not secrets).

# RevenueCat public SDK keys (RevenueCat dashboard > Project > API keys)
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project used for online rooms (Realtime only, no tables needed)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public links shown in the app and required by both stores
EXPO_PUBLIC_PRIVACY_URL=https://wildcardz.app/privacy
EXPO_PUBLIC_TERMS_URL=https://wildcardz.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@wildcardz.app
